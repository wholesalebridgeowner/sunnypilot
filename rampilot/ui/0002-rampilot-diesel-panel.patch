+void HudRendererSP::updateDiesel(const UIState &s, bool current) {
+  dieselRows.clear();
+  if (s.scene.started_frame != dieselStartedFrame) {
+    dieselStartedFrame = s.scene.started_frame;
+    dieselVehicle = false;
+  }
+  if (!current) {
+    if (dieselVehicle) dieselRows.push_back({tr("DPF regen"), tr("Unknown")});
+    return;
+  }
+  const auto state = (*s.sm)["carStateSP"].getCarStateSP();
+  dieselVehicle = state.getDieselSupported();
+  if (!dieselVehicle) return;
+
+  QString regen = tr("Unknown");
+  if (state.getDpfRegenValid()) {
+    regen = state.getDpfRegenActive() ? tr("Active") : tr("Inactive");
+  }
+  dieselRows.push_back({tr("DPF regen"), regen});
+  auto add = [this](const QString &label, bool valid, float value, int decimals, const QString &unit) {
+    if (valid && std::isfinite(value) && value >= 0.f) {
+      dieselRows.push_back({label, QString::number(value, 'f', decimals) + " " + unit});
+    }
+  };
+  add(tr("Fuel est."), state.getFuelRemainingUsGalValid(), state.getFuelRemainingUsGal(), 1, tr("US gal"));
+  add(tr("Average"), state.getAvgFuelEconomyUsMpgValid(), state.getAvgFuelEconomyUsMpg(), 1, tr("MPG"));
+  add(tr("Current"), state.getInstantFuelEconomyUsMpgValid(), state.getInstantFuelEconomyUsMpg(), 1, tr("MPG"));
+  add(tr("Idle fuel"), state.getIdleFuelUsGalPerHourValid(), state.getIdleFuelUsGalPerHour(), 2, tr("gal/h"));
+  add(tr("Range"), state.getRangeMilesValid(), state.getRangeMiles(), 0, tr("mi"));
+  add(tr("DEF"), state.getDefPercentValid(), state.getDefPercent(), 0, tr("%"));
+}
+
+void HudRendererSP::drawDiesel(QPainter &p, const QRect &surface_rect) {
+  if (dieselRows.isEmpty()) return;
+  // The speed-limit sign ends at y=477 in its taller US layout. Keep the bottom overlay clear too.
+  constexpr int top = 496, left = 60, width = 310, inset = 12, rowHeight = 35;
+  const QRect box(left, top, width, 2 * inset + rowHeight * dieselRows.size());
+  if (!surface_rect.adjusted(0, 0, 0, -100).contains(box)) return;
+  p.save();
+  p.setPen(Qt::NoPen);
+  p.setBrush(QColor(0, 0, 0, 175));
+  p.drawRoundedRect(box, 12, 12);
+  p.setFont(InterFont(24, QFont::DemiBold));
+  const int valueWidth = 157;
+  int y = top + inset;
+  for (const auto &row : dieselRows) {
+    const QRect label(left + inset, y, width - 2 * inset - valueWidth - 8, rowHeight);
+    const QRect value(box.right() - inset - valueWidth + 1, y, valueWidth, rowHeight);
+    p.setPen(QColor(205, 209, 214));
+    p.drawText(label, Qt::AlignLeft | Qt::AlignVCenter, p.fontMetrics().elidedText(row.first, Qt::ElideRight, label.width()));
+    p.setPen(Qt::white);
+    p.drawText(value, Qt::AlignRight | Qt::AlignVCenter, p.fontMetrics().elidedText(row.second, Qt::ElideRight, value.width()));
+    y += rowHeight;
+  }
+  p.restore();
+}
