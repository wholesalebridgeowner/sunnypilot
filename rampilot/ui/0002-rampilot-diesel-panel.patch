+void HudRendererSP::updateDiesel(const UIState &s, bool current) {
+  dieselRows.clear();
+  if (!current) return;
+  const auto state = (*s.sm)["carStateSP"].getCarStateSP();
+  if (!state.getDieselSupported()) return;
+
+  auto add = [this](const QString &label, bool valid, double value, int decimals, const QString &unit) {
+    if (valid && std::isfinite(value) && value >= 0.f) {
+      dieselRows.push_back({label, QString::number(value, 'f', decimals) + " " + unit});
+    }
+  };
+  constexpr double litersPerUSGallon = 3.785411784;
+  constexpr double kmPerMile = 1.609344;
+  const double volumeScale = is_metric ? litersPerUSGallon : 1.0;
+  auto economy = [this, &add](const QString &label, bool valid, double mpg) {
+    if (is_metric && mpg <= 0.0) return;
+    add(label, valid && std::isfinite(mpg), is_metric ? 100.0 * litersPerUSGallon / (kmPerMile * mpg) : mpg,
+        1, is_metric ? tr("L/100 km") : tr("MPG"));
+  };
+  add(tr("Fuel est."), state.getFuelRemainingUsGalValid(), state.getFuelRemainingUsGal() * volumeScale,
+      1, is_metric ? tr("L") : tr("US gal"));
+  economy(tr("Average"), state.getAvgFuelEconomyUsMpgValid(), state.getAvgFuelEconomyUsMpg());
+  economy(tr("Current"), state.getInstantFuelEconomyUsMpgValid(), state.getInstantFuelEconomyUsMpg());
+  add(tr("Idle fuel"), state.getIdleFuelUsGalPerHourValid(), state.getIdleFuelUsGalPerHour() * volumeScale,
+      2, is_metric ? tr("L/h") : tr("gal/h"));
+  add(tr("Range"), state.getRangeMilesValid(), state.getRangeMiles() * (is_metric ? kmPerMile : 1.0),
+      0, is_metric ? tr("km") : tr("mi"));
+  add(tr("DEF"), state.getDefPercentValid(), state.getDefPercent(), 0, tr("%"));
+  if (!dieselRows.empty() || state.getDpfRegenValid()) {
+    const QString regen = state.getDpfRegenValid()
+      ? (state.getDpfRegenActive() ? tr("Active") : tr("Inactive")) : tr("Unknown");
+    dieselRows.insert(dieselRows.begin(), {tr("DPF regen"), regen});
+  }
+}
+
+void HudRendererSP::drawDiesel(QPainter &p, const QRect &surface_rect) {
+  if (dieselRows.isEmpty()) return;
+  // The speed-limit sign ends at y=477 in its taller US layout. Keep the bottom overlay clear too.
+  constexpr int top = 496, left = 60, width = 310, inset = 12, rowHeight = 35;
+  const QRect box(left, top, width, 2 * inset + rowHeight * dieselRows.size());
+  if (!surface_rect.adjusted(0, 0, 0, -100).contains(box)) return;
+  p.save();
+  p.setPen(Qt::NoPen);
+  p.setBrush(QColor(0, 0, 0, 175));
+  p.drawRoundedRect(box, 12, 12);
+  p.setFont(InterFont(24, QFont::DemiBold));
+  const int valueWidth = 157;
+  int y = top + inset;
+  for (const auto &row : dieselRows) {
+    const QRect label(left + inset, y, width - 2 * inset - valueWidth - 8, rowHeight);
+    const QRect value(box.right() - inset - valueWidth + 1, y, valueWidth, rowHeight);
+    p.setPen(QColor(205, 209, 214));
+    p.drawText(label, Qt::AlignLeft | Qt::AlignVCenter, p.fontMetrics().elidedText(row.first, Qt::ElideRight, label.width()));
+    p.setPen(Qt::white);
+    p.drawText(value, Qt::AlignRight | Qt::AlignVCenter, p.fontMetrics().elidedText(row.second, Qt::ElideRight, value.width()));
+    y += rowHeight;
+  }
+  p.restore();
+}
