+static bool freshCarStateSP(const UIState &s) {
+  const SubMaster &sm = *s.sm;
+  const uint64_t receivedAt = sm.rcv_time("carStateSP");
+  const uint64_t now = nanos_since_boot();
+  // Match the 100 Hz service's 100 ms receive timeout even when simulation leaves alive set.
+  return receivedAt != 0 && now >= receivedAt && now - receivedAt < 100'000'000ULL &&
+         sm.rcv_frame("carStateSP") >= s.scene.started_frame && sm.alive("carStateSP") && sm.valid("carStateSP") &&
+         sm["carStateSP"].which() == cereal::Event::CAR_STATE_S_P;
+}
