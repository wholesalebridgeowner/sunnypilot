+// RamPilot: US-style rectangular sign in mph, round red-ring sign in km/h, under the MAX box
+void HudRendererSP::drawSpeedLimitSign(QPainter &p, const QRect &surface_rect) {
+  p.save();
+  const QString value = QString::number(std::nearbyint(speedLimit));
+  if (is_metric) {
+    const QRect r(60 + (172 - 184) / 2, 45 + 204 + 24, 184, 184);
+    p.setPen(QPen(QColor(0xe0, 0x1b, 0x24), 18));
+    p.setBrush(Qt::white);
+    p.drawEllipse(r.adjusted(9, 9, -9, -9));
+    p.setPen(Qt::black);
+    p.setFont(InterFont(value.length() > 2 ? 62 : 76, QFont::Bold));
+    p.drawText(r, Qt::AlignCenter, value);
+  } else {
+    const QRect r(60, 45 + 204 + 24, 172, 204);
+    p.setPen(QPen(Qt::black, 6));
+    p.setBrush(Qt::white);
+    p.drawRoundedRect(r.adjusted(3, 3, -3, -3), 18, 18);
+    p.setPen(QPen(Qt::black, 4));
+    p.setBrush(Qt::NoBrush);
+    p.drawRoundedRect(r.adjusted(14, 14, -14, -14), 10, 10);
+    p.setPen(Qt::black);
+    p.setFont(InterFont(34, QFont::Bold));
+    p.drawText(r.adjusted(0, 26, 0, 0), Qt::AlignTop | Qt::AlignHCenter, "SPEED");
+    p.drawText(r.adjusted(0, 64, 0, 0), Qt::AlignTop | Qt::AlignHCenter, "LIMIT");
+    p.setFont(InterFont(82, QFont::Bold));
+    p.drawText(r.adjusted(0, 96, 0, 0), Qt::AlignTop | Qt::AlignHCenter, value);
+  }
+  p.restore();
+}
